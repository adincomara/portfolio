<section id="about" class="reveal flex flex-col-reverse sm:flex-row items-center sm:items-start justify-between gap-10 pt-4">
  <div class="space-y-5 text-center sm:text-left flex-1">
    
    <!-- Live Terminal Status Pill -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800/50 text-[11px] font-mono text-indigo-700 dark:text-indigo-300 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>$ init --profile: Adin Comara</span>
      <span class="cursor-blink font-bold text-indigo-500">_</span>
    </div>

    <div class="space-y-1.5">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Adin Comara
      </h1>
      <p class="text-base sm:text-lg font-semibold text-indigo-600 dark:text-indigo-400 font-mono">
        Backend & Full-Stack Developer • AI Practitioner
      </p>
    </div>

    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed max-w-xl">
      Fokus pada rekayasa sistem web & backend menggunakan ekosistem <strong>Laravel & PHP</strong>, perancangan algoritma pemetaan, serta implementasi <strong>Artificial Intelligence (Multimodal Vision OCR & LLM Integration)</strong> untuk otomasi proses data modern.
    </p>

    <!-- Badges & Contact -->
    <div class="pt-2 flex flex-wrap items-center justify-center sm:justify-start gap-3 text-xs">
      <a href="mailto:adincomara@gmail.com" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white font-semibold shadow-md shadow-indigo-500/20 active:scale-95 transition">
        <span>✉️</span>
        <span>adincomara@gmail.com</span>
      </a>
      <a href="https://github.com/adincomara" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 text-xs font-semibold hover:border-indigo-500 dark:hover:border-indigo-400 shadow-sm transition">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
        <span>github.com/adincomara</span>
      </a>
    </div>
  </div>

  <!-- Avatar Photo: 100% BULAT Lingkaran Presisi dengan Efek Glowing Aura -->
  <div class="relative shrink-0 flex items-center justify-center">
    <!-- Ambient Glowing Aura -->
    <div class="avatar-aura absolute inset-0 rounded-full bg-gradient-to-tr from-indigo-500 via-sky-400 to-indigo-600 blur-xl opacity-50"></div>
    
    <!-- Circular Frame -->
    <div class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-full p-1.5 bg-gradient-to-tr from-indigo-500 via-sky-400 to-indigo-600 shadow-2xl">
      <div class="w-full h-full rounded-full overflow-hidden bg-slate-100 dark:bg-slate-900">
        <img src="/profile.jpg" alt="Adin Comara (Maulana Muhammadin Comara)" class="w-full h-full object-cover rounded-full hover:scale-105 transition-transform duration-500" width="176" height="176" loading="eager" />
      </div>
    </div>
  </div>
</section>
